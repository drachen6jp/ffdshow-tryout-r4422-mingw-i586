SRCS_C := \
	src/ffdebug.c \
	src/ffmpeg/libavcodec/golomb.c \
	src/settings/lzo/minilzo.c

SRCS_ASM := \
	src/cpuid.asm \
	src/memcpy.asm \
	src/subtitles/fontRenderer.asm \
	src/imgFilters/simple_idct_mmx.asm \
	src/imgFilters/Skal/fdct_mmx_skal.asm \
	src/imgFilters/Skal/fdct_sse2_skal.asm \
	src/imgFilters/Skal/idct_mmx.asm \
	src/imgFilters/Skal/idct_sse2_dmitry.asm \
	src/convert/colorspace_rgb_mmx.asm \
	src/audioFilters/dotproduct.asm \
	src/audioFilters/TaudioFilterConvert.asm

OBJS := $(addprefix $(OBJDIR)/,$(SRCS_CPP:.cpp=.o) $(SRCS_C:.c=.o) $(SRCS_ASM:.asm=.o))
RES_OBJ := $(OBJDIR)/ffdshow_res.o $(OBJDIR)/manifest_res.o
BOOST_OBJS := $(OBJDIR)/boost_thread.o $(OBJDIR)/boost_tss_pe.o
BOOST_LIB := $(OBJDIR)/libboost_thread.a

LDLIBS := -lkernel32 -luser32 -lgdi32 -lwinspool -lcomdlg32 -ladvapi32 \
	-lshell32 -lole32 -loleaut32 -luuid -lwinmm -lcomctl32 -ldinput \
	-ldxguid -lshlwapi -ld3d9
LDFLAGS := -Wl,--enable-stdcall-fixup -Wl,--large-address-aware \
	-Wl,--major-subsystem-version=5,--minor-subsystem-version=0 \
	-static-libgcc -static-libstdc++

.PHONY: all clean check
all: $(TARGET)

$(TARGET): $(OBJS) $(RES_OBJ) $(BOOST_LIB) $(OBJDIR)/guids.o $(OBJDIR)/interlocked_shim.o $(OBJDIR)/uuidof_shim.o $(OBJDIR)/win2k_compat.o src/ffdshow.def | bin
	$(CXX) -shared -o $@ $(OBJS) $(RES_OBJ) $(BOOST_LIB) $(OBJDIR)/guids.o $(OBJDIR)/interlocked_shim.o $(OBJDIR)/uuidof_shim.o $(OBJDIR)/win2k_compat.o src/ffdshow.def $(LDFLAGS) $(LDLIBS)

$(OBJDIR)/guids.o: $(SHIMDIR)/guids.cpp
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

$(OBJDIR)/interlocked_shim.o: $(SHIMDIR)/interlocked_shim.c
	@mkdir -p $(@D)
	$(CC) $(ARCHFLAGS) -O2 -c -o $@ $<

$(OBJDIR)/uuidof_shim.o: $(SHIMDIR)/uuidof_shim.c
	@mkdir -p $(@D)
	$(CC) $(ARCHFLAGS) -O2 -c -o $@ $<


$(OBJDIR)/win2k_compat.o: $(SHIMDIR)/win2k_compat.c
	@mkdir -p $(@D)
	$(CC) $(ARCHFLAGS) -O2 -c -o $@ $<
bin:
	mkdir -p bin

# svn_version.h (update_version.bat + SubWCRev の代替: リビジョン 4422 固定)
src/svn_version.h:
	printf '#define SVN_REVISION 4422\n#define BUILD_YEAR "%s"\n#define BUILD_MONTH "%s"\n#define BUILD_DAY "%s"\n' $$(date +%Y) $$(date +%m) $$(date +%d) > $@

# stdafx.h を先に読むため全 TU が svn_version.h に依存するわけではないが、
# version.h 経由で必要なのはリソースだけなので、依存は .rc 側に付ける
$(OBJDIR)/ffdshow_res.o: src/ffdshow.rc src/ffdshow.rc2 src/version.h src/svn_version.h
	@mkdir -p $(@D)
	$(WINDRES) $(DEFS) $(INCS) -I src -o $@ $<

# マニフェスト (comctl32 v6) をリソース ID 2 で埋め込む
$(OBJDIR)/manifest_res.o: $(SHIMDIR)/ffdshow.ax.manifest
	@mkdir -p $(@D)
	printf '2 24 "%s"\n' "$(abspath $(SHIMDIR)/ffdshow.ax.manifest)" > $(OBJDIR)/manifest.rc
	$(WINDRES) -o $@ $(OBJDIR)/manifest.rc

# boost::thread 1.49 (win32) - ffdshow が使うのは mutex/thread 系のみ
# thread_specific_ptr は未使用なので tss は tss_pe で足りる (駄目なら tss_null.cpp に差し替え)
$(OBJDIR)/boost_thread.o: $(BOOST_DIR)/libs/thread/src/win32/thread.cpp
	@mkdir -p $(@D)
	$(CXX) $(ARCHFLAGS) -std=gnu++98 -DBOOST_THREAD_BUILD_LIB -DBOOST_ALL_NO_LIB -I$(BOOST_DIR) -c -o $@ $<
$(OBJDIR)/boost_tss_pe.o: $(BOOST_DIR)/libs/thread/src/win32/tss_pe.cpp
	@mkdir -p $(@D)
	$(CXX) $(ARCHFLAGS) -std=gnu++98 -DBOOST_THREAD_BUILD_LIB -DBOOST_ALL_NO_LIB -I$(BOOST_DIR) -c -o $@ $<
$(BOOST_LIB): $(BOOST_OBJS)
	$(AR) rcs $@ $(BOOST_OBJS)
	$(RANLIB) $@

# SIMD を使う TU は実行時 CPUID ディスパッチ前提なので、対象ファイルだけ
# MMX/SSE2 を有効にして組む (simd.h の Tsse2 等は __SSE2__ でガードされている)
$(OBJDIR)/src/convert/Tconvert.o $(OBJDIR)/src/convert/ffdshow_converters.o: CXXFLAGS += -mmmx -msse2 -mno-cmov
$(OBJDIR)/src/convert/ffdshow_converters2_mmx.o: CXXFLAGS += -mmmx -mno-cmov
$(OBJDIR)/src/convert/ffdshow_converters2_mmxext.o: CXXFLAGS += -mmmx -msse -mno-cmov
$(OBJDIR)/src/convert/ffdshow_converters2_sse2.o: CXXFLAGS += -mmmx -msse2 -mno-cmov
$(OBJDIR)/src/subtitles/CPolygon.o $(OBJDIR)/src/subtitles/Tfont.o $(OBJDIR)/src/subtitles/TsubtitleText.o $(OBJDIR)/src/subtitles/TrenderedTextSubtitleWord.o $(OBJDIR)/src/subtitles/TspuImage.o $(OBJDIR)/src/subtitles/TsubtitleDVD.o: CXXFLAGS += -mmmx -msse2 -mno-cmov
$(OBJDIR)/src/imgFilters/TimgFilterNoise.o $(OBJDIR)/src/settings/filters/TnoiseSettings.o: CXXFLAGS += -mmmx -msse2 -mno-cmov
$(OBJDIR)/src/imgFilters/TimgFilterBitmap.o $(OBJDIR)/src/imgFilters/TimgFilterBlur.o $(OBJDIR)/src/imgFilters/TimgFilterChroma.o $(OBJDIR)/src/imgFilters/TimgFilterColorize.o $(OBJDIR)/src/imgFilters/TimgFilterDeinterlace.o $(OBJDIR)/src/imgFilters/TimgFilterGradualDenoise.o $(OBJDIR)/src/imgFilters/TimgFilterLuma.o $(OBJDIR)/src/imgFilters/TimgFilterPostproc.o $(OBJDIR)/src/imgFilters/TimgFilterSharpen.o $(OBJDIR)/src/imgFilters/TimgFilterWarpsharp.o $(OBJDIR)/src/imgFilters/SimpleResize.o: CXXFLAGS += -mmmx -msse2 -mno-cmov
$(OBJDIR)/src/audioFilters/TaudioFilter.o: CXXFLAGS += -mmmx -msse2 -mno-cmov
$(OBJDIR)/src/imgFilters/2xsai.o $(OBJDIR)/src/imgFilters/TimgFilterDCT.o $(OBJDIR)/src/imgFilters/TimgFilterPerspective.o $(OBJDIR)/src/imgFilters/TimgFilterShowMV.o $(OBJDIR)/src/convert/TrgbPrimaries.o $(OBJDIR)/src/TffdshowEnc.o $(OBJDIR)/src/codecs/TvideoCodecLibavcodec.o: CXXFLAGS += -mmmx
$(OBJDIR)/src/imgFilters/TimgFilterDenoise3d.o $(OBJDIR)/src/imgFilters/nic/nic_postProcess.o $(OBJDIR)/src/imgFilters/asharp/asharp.o $(OBJDIR)/src/convert/image.o $(OBJDIR)/src/audioFilters/firfilter.o: CXXFLAGS += -mmmx -msse -mno-cmov
$(OBJDIR)/src/convert/Tconvert_mmx.o: CXXFLAGS += -mmmx -mno-cmov
$(OBJDIR)/src/convert/Tconvert_mmxext.o: CXXFLAGS += -mmmx -msse -mno-cmov
$(OBJDIR)/src/convert/Tconvert_sse2.o: CXXFLAGS += -mmmx -msse2 -mno-cmov
$(OBJDIR)/src/convert/Tconvert_yuy2rgb_mmx.o: CXXFLAGS += -mmmx -mno-cmov
$(OBJDIR)/src/convert/Tconvert_yuy2rgb_sse2.o: CXXFLAGS += -mmmx -msse2 -mno-cmov

$(OBJDIR)/%.o: %.cpp
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

$(OBJDIR)/%.o: %.c
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -c -o $@ $<

# .asm は VS 側 yasm.cmd と同じフラグ (Win32: -DPREFIX -DWIN32 -DHAVE_SSE3 -DUSE32 -Dalloc -Dexec)
$(OBJDIR)/%.o: %.asm
	@mkdir -p $(@D)
	$(YASM) -f win32 -DPREFIX -DWIN32 -DHAVE_SSE3 -DUSE32 -Dalloc -Dexec -I $(dir $<) -I src -o $@ $<

clean:
	rm -rf obj/MinGW32 bin/ffdshow.ax

# 検証の門: 輸入に XP API が無いこと、輸出 13 件が公式と一致すること
check: $(TARGET)
	@echo "--- DLL Name ---"
	@$(PREFIX)objdump -p $(TARGET) | grep "DLL Name"
	@echo "--- XP API check (何も出なければ合格) ---"
	@$(PREFIX)objdump -p $(TARGET) | grep -E "EncodePointer|DecodePointer|SListHead|EntrySList|QueryDepthSList|ConditionVariable|GetThreadId|wcscpy_s|wcscat_s|wcsncpy_s|wcsncat_s|snwprintf_s|wmakepath_s|wsplitpath_s" || echo OK
	@echo "--- exports ---"
	@$(PREFIX)objdump -p $(TARGET) | sed -n "/Ordinal\/Name Pointer/,/^$$/p" | grep -E "^\s*\[\s*[0-9]+\]" | grep -oE "[A-Za-z_][A-Za-z0-9_]*$$" | sort
	@echo "--- cmov census ---"
	@$(PREFIX)objdump -d $(TARGET) | grep -c cmov || true
