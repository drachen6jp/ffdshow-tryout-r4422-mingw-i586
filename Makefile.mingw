# Makefile.mingw - ffdshow.ax (ffdshow-tryout r4422) MinGW cross build
# 置き場所: trunk ルート (ffdshow_2010.sln と同じディレクトリ)
# 使い方:  make -f Makefile.mingw -j14
# 前提:    boost 1.49.0 を展開し BOOST_DIR で指す (既定は ../boost_1_49_0)
# 出力:    bin/ffdshow.ax (ffmpeg.dll と同じ bin/ に出る)

PREFIX  ?= i686-w64-mingw32-
CC      := $(PREFIX)gcc
CXX     := $(PREFIX)g++
WINDRES := $(PREFIX)windres
AR      := $(PREFIX)ar
RANLIB  := $(PREFIX)ranlib
YASM    ?= yasm

BOOST_DIR ?= ../boost_1_49_0
SHIMDIR   := mingw_shims
OBJDIR    := obj/MinGW32/ffdshow
TARGET    := bin/ffdshow.ax

ARCHFLAGS := -march=i586 -O2 -pipe -fomit-frame-pointer
DEFS := -DNDEBUG -DWIN32 -D_WINDOWS -D_CRT_NONSTDC_NO_WARNINGS \
	-DARCH_IS_32BIT -DARCH_IS_IA32 -DUNICODE -D_UNICODE \
	-DWINVER=0x0500 -D_WIN32_WINNT=0x0500 -D_WIN32_IE=0x0600 \
	-DBOOST_THREAD_USE_LIB
INCDIRS := $(SHIMDIR) src src/baseclasses src/settings src/dialog src/imgFilters \
	src/codecs src/convert src/subtitles src/settings/filters src/audioFilters \
	src/ffmpeg src/muxers src/acm src/filters $(BOOST_DIR)
INCS := $(addprefix -I,$(INCDIRS))
CXXFLAGS := $(ARCHFLAGS) -std=gnu++98 -fpermissive -Drestrict=__restrict__ $(DEFS) $(INCS)
CFLAGS   := $(ARCHFLAGS) -std=gnu99 $(DEFS) $(INCS)

